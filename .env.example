# DeepCement 环境变量配置
# 复制此文件为 .env 并填入实际值

# ===== LLM 配置 =====
# DeepSeek API
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-chat

# ===== Embedding 配置 =====
# 使用本地 HuggingFace 模型 BAAI/bge-large-zh，无需配置 API

# ===== 检索配置 =====
RETRIEVER_TOP_K=2

# ===== 路径配置 =====
DATA_RAW_DIR=data/raw
DATA_INDEX_DIR=data/index
REPORT_OUTPUT_DIR=agent/report/output
