# DeepCement 环境变量配置
# 复制此文件为 .env 并填入实际值

# ===== LLM 配置 =====
# DeepSeek API
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-chat

# ===== Embedding 配置 =====
# 使用本地 HuggingFace 模型 BAAI/bge-large-zh，无需配置 API

# ===== 检索配置 =====
RETRIEVER_TOP_K=2

# ===== Reranker 重排序配置 =====
RERANKER_ENABLED=true
RERANKER_MODEL_PATH=models/bge-reranker-v2-m3
RERANKER_TOP_N=5
RERANKER_CANDIDATE_MULTIPLIER=3

# ===== 路径配置 =====
DATA_RAW_DIR=data/raw
DATA_INDEX_DIR=data/index
REPORT_OUTPUT_DIR=agent/report/output

# ===== Milvus / Zilliz Cloud 配置 =====
MILVUS_URI=https://your-cluster.serverless.aws-eu-central-1.cloud.zilliz.com
MILVUS_TOKEN=username:password
MILVUS_COLLECTION_NAME=cement_docs
MILVUS_DIM=1024
